# VPS 배포용 환경변수 — 서버에서 `cp .env.vps.example .env` 후 값을 채우세요 (.env 는 git 에 올리지 않음)

# 이 파일(docker-compose.vps.yml)을 기본 compose 파일로 사용 (기존 docker-compose.yml 은 로컬 단독 실행용)
COMPOSE_FILE=docker-compose.vps.yml

# 서비스할 도메인 (Cloudflare DNS 에 이 이름의 A 레코드가 서버 IP 를 가리켜야 함)
DOMAIN=play.example.com

# Redis 비밀번호 — 영문/숫자만 쓰세요 (URL 에 들어가므로 특수문자는 문제를 일으킵니다)
# 생성: openssl rand -hex 24
REDIS_PASSWORD=change-me

# 광고(선택) — 승인 후에만 채우세요. docs/ADS_SETUP.md 참고
ADSENSE_PUBLISHER_ID=
ADSENSE_LOBBY_SLOT=
ADSENSE_GAME_END_SLOT=
