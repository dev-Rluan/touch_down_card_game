# {$DOMAIN} 은 docker-compose.yml 의 DOMAIN 환경변수 (예: play.rluan.dev)
# Caddy 가 Let's Encrypt 인증서를 자동으로 발급/갱신한다. WebSocket(Socket.IO)도 별도 설정 없이 프록시된다.
{$DOMAIN} {
	reverse_proxy app:3000 {
		# 서버(Express)가 trust proxy 1 로 설정되어 있어 X-Forwarded-* 헤더를 신뢰한다
		health_uri /healthz
		health_interval 30s
	}
	# 응답 압축은 앱(compression)이 이미 처리한다
}
